{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insider-alpha/schema/backtest.schema.json",
  "title": "backtest.json",
  "description": "Portfolio results. Every variant reports gross and net series and statistics side by side; the dashboard refuses to display a Sharpe ratio without its net counterpart.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "generated_at",
    "data_status",
    "notes",
    "primary_variant_id",
    "benchmark_label",
    "variants"
  ],
  "$defs": {
    "performance_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ann_return",
        "ann_vol",
        "sharpe",
        "sharpe_std_error",
        "sortino",
        "max_drawdown",
        "calmar",
        "hit_rate_monthly",
        "best_month",
        "worst_month"
      ],
      "properties": {
        "ann_return": { "type": "number", "description": "Decimal, not percent. 0.075 means 7.5%." },
        "ann_vol": { "type": "number", "minimum": 0 },
        "sharpe": { "type": "number" },
        "sharpe_std_error": { "type": ["number", "null"], "minimum": 0 },
        "sortino": { "type": "number" },
        "max_drawdown": { "type": "number", "maximum": 0, "description": "Negative decimal." },
        "calmar": { "type": "number" },
        "hit_rate_monthly": { "type": "number", "minimum": 0, "maximum": 1 },
        "best_month": { "type": "number" },
        "worst_month": { "type": "number" }
      }
    }
  },
  "properties": {
    "schema_version": { "type": "string" },
    "artifact": { "const": "backtest" },
    "generated_at": { "type": "string", "format": "date-time" },
    "data_status": { "enum": ["real", "placeholder"] },
    "notes": { "type": ["string", "null"] },
    "primary_variant_id": {
      "type": "string",
      "description": "Must match the id of one entry in `variants`. This is the variant the dashboard headlines."
    },
    "benchmark_label": { "type": "string" },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "description",
          "hedge",
          "holding_period_months",
          "arm",
          "cost_assumption_bps",
          "n_months",
          "avg_n_positions",
          "equity_curve",
          "drawdown",
          "monthly_returns",
          "turnover",
          "stats"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "hedge": { "enum": ["long_only", "quintile_spread", "beta_sector_matched_etf"] },
          "holding_period_months": { "type": "integer", "minimum": 1 },
          "arm": { "enum": ["opportunistic", "all_insiders"] },
          "cost_assumption_bps": { "type": "number", "minimum": 0 },
          "n_months": { "type": "integer", "minimum": 1 },
          "avg_n_positions": { "type": "number", "minimum": 0 },
          "equity_curve": {
            "type": "array",
            "description": "Cumulative growth of 1. First point should be the pre-sample anchor at 1.0.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["date", "gross", "net", "benchmark"],
              "properties": {
                "date": { "type": "string", "format": "date" },
                "gross": { "type": "number", "minimum": 0 },
                "net": { "type": "number", "minimum": 0 },
                "benchmark": { "type": ["number", "null"], "minimum": 0 }
              }
            }
          },
          "drawdown": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["date", "gross", "net"],
              "properties": {
                "date": { "type": "string", "format": "date" },
                "gross": { "type": "number", "maximum": 0 },
                "net": { "type": "number", "maximum": 0 }
              }
            }
          },
          "monthly_returns": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["month", "gross", "net", "benchmark"],
              "properties": {
                "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
                "gross": { "type": "number" },
                "net": { "type": "number" },
                "benchmark": { "type": ["number", "null"] }
              }
            }
          },
          "turnover": {
            "type": "object",
            "additionalProperties": false,
            "required": ["annualized", "monthly"],
            "properties": {
              "annualized": {
                "type": "number",
                "minimum": 0,
                "description": "One-sided traded notional over book value, per year. 4.2 means the book turns over 4.2 times a year."
              },
              "monthly": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["month", "turnover"],
                  "properties": {
                    "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
                    "turnover": { "type": "number", "minimum": 0 }
                  }
                }
              }
            }
          },
          "stats": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gross", "net", "benchmark"],
            "properties": {
              "gross": { "$ref": "#/$defs/performance_block" },
              "net": { "$ref": "#/$defs/performance_block" },
              "benchmark": {
                "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/performance_block" }]
              }
            }
          }
        }
      }
    }
  }
}
