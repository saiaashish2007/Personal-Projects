# Regenerable market/SEC caches. Several processed tables exceed GitHub's 100 MB
# limit (prices ~328 MB, insider_trades ~179 MB). Re-run scripts/01_ingest.py
# through scripts/06_attribution.py locally. The dashboard reads artifacts/*.json.
data/raw/
data/processed/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node / Next.js
web/node_modules/
web/.next/
web/out/
web/.vercel/
web/next-env.d.ts
web/tsconfig.tsbuildinfo

# Local copy of artifacts/ for build hosts that cannot read above the project root.
# JSON files are committed so Vercel can build without "include files outside root".
# Keep schema/ and generated junk out.
web/artifacts/schema/

# OS
.DS_Store
